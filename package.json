{
  "name": "silverware-libraries",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check-build": "node scripts/build.mjs --check",
    "verify": "tsc --noEmit --noUnusedLocals && vitest run && node scripts/build.mjs --check",
    "watch": "node scripts/build.mjs --watch",
    "deploy": "node scripts/deploy.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:ui:open": "playwright test --ui",
    "test:ui:sb": "node scripts/ui-tests.mjs silverbullet",
    "test:ui:install": "playwright install chromium",
    "playground": "node scripts/playground.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "emojibase-data": "18.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
