{
  "name": "silverware-libraries",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check-build": "node scripts/build.mjs --check",
    "verify": "tsc --noEmit --noUnusedLocals && vitest run && node scripts/build.mjs --check",
    "watch": "node scripts/build.mjs --watch",
    "deploy": "node scripts/deploy.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:ui:open": "playwright test --ui",
    "test:ui:sb": "node scripts/ui-tests.mjs silverbullet",
    "test:ui:sb:edge": "node scripts/ui-tests.mjs edge",
    "test:ui:install": "playwright install chromium",
    "playground": "node scripts/playground.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/markdown": "1.7.2",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.5",
    "chart.js": "4.5.1",
    "docx-preview": "0.4.1",
    "emojibase-data": "18.0.0",
    "esbuild": "^0.28.2",
    "exceljs": "4.4.0",
    "fractional-indexing": "3.2.0",
    "jsdom": "^30.1.3",
    "jszip": "3.10.2",
    "lucide-static": "1.71.0",
    "pdfjs-dist": "6.4.299",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
