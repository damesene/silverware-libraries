[
  "div.swd-conflict.swd-settings [aria-label=\"Changed since it was shown\" aria-modal=\"true\" role=\"dialog\" tabindex=\"-1\"]",
  "  div.swd-settings-head",
  "    div.swd-settings-titles",
  "      h2.swd-settings-title \"Changed since it was shown\"",
  "      p.swd-settings-subtitle \"The properties of Tasks were changed elsewhere since: nothing was written\"",
  "    button.swd-settings-close [aria-label=\"Close (Esc)\" title=\"Close (Esc)\" type=\"button\"]",
  "      svg [aria-hidden=\"true\" svg=4659c561]",
  "  div.swd-settings-body",
  "    div.swd-conflict-body",
  "      p.swd-conflict-failed.swd-conflict-note [hidden=\"\"]",
  "      h3.swd-conflict-section \"What writing yours changes\"",
  "      div.swd-conflict-diffs [aria-live=\"polite\"]",
  "        details.swd-conflict-document [open=\"\"]",
  "          summary.swd-conflict-summary",
  "            span.swd-conflict-name \"<folder>/Page/db-tasks\"",
  "            a.swd-conflict-open [href=\"<folder>/Page/db-tasks\" title=\"Open <folder>/Page/db-tasks\"] \"Open\"",
  "          div.swd-diff",
  "            div.swd-diff-run",
  "              div.swd-diff-line-number \"line 8\"",
  "              div.swd-diff-removed \"status: { type: select, label: Phase, options: [Todo, Done] }\"",
  "              div.swd-diff-added \"status: { type: select, label: State, options: [Todo, Done] }\"",
  "  div.swd-settings-foot",
  "    button.swd-settings-cancel [type=\"button\"] \"Keep theirs\"",
  "    button.swd-conflict-force.swd-settings-save [type=\"button\"] \"Write mine\""
]
