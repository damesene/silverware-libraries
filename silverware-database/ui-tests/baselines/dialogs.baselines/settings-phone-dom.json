[
  "div.swd-settings [aria-label=\"Silverware Database settings\" aria-modal=\"true\" role=\"dialog\" tabindex=\"-1\"]",
  "  div.swd-settings-head",
  "    div.swd-settings-titles",
  "      h2.swd-settings-title \"Silverware Database settings\"",
  "      p.swd-settings-subtitle \"For the whole space: saved in its configuration\"",
  "    button.swd-settings-close [aria-label=\"Close (Esc)\" title=\"Close (Esc)\" type=\"button\"]",
  "      svg [aria-hidden=\"true\" svg=db4d55a1]",
  "  div.swd-settings-tabs [role=\"tablist\"]",
  "    button.swd-settings-tab [aria-selected=\"true\" data-swd-tab=\"general\" role=\"tab\" type=\"button\"] \"General\"",
  "    button.swd-settings-tab [aria-selected=\"false\" data-swd-tab=\"views\" role=\"tab\" type=\"button\"] \"Views\"",
  "    button.swd-settings-tab [aria-selected=\"false\" data-swd-tab=\"modules\" role=\"tab\" type=\"button\"] \"Modules\"",
  "  div.swd-settings-body",
  "    div.swd-settings-panel [data-swd-panel=\"general\" role=\"tabpanel\"]",
  "      div.swd-settings-card",
  "        label.swd-settings-row",
  "          span.swd-settings-label",
  "            span.swd-settings-name \"Items shown at first\"",
  "            span.swd-settings-hint \"In each view and each group of it; Load more shows as many more. 10 to 10,000\"",
  "          input [data-swd-setting=\"silverware.database.pageSize\" title=\"\" type=\"number\" :value=\"50\"]",
  "    div.swd-settings-panel [data-swd-panel=\"views\" hidden=\"\" role=\"tabpanel\"]",
  "      div.swd-settings-card",
  "        label.swd-settings-row",
  "          span.swd-settings-label",
  "            span.swd-settings-name \"Table\"",
  "            span.swd-settings-hint \"The view table: offered in the switcher above every database\"",
  "          span.swd-settings-switch",
  "            input [data-swd-view=\"table\" role=\"switch\" type=\"checkbox\" :checked=true]",
  "            span.swd-settings-knob",
  "        label.swd-settings-row",
  "          span.swd-settings-label",
  "            span.swd-settings-name \"List\"",
  "            span.swd-settings-hint \"The view list: offered in the switcher above every database\"",
  "          span.swd-settings-switch",
  "            input [data-swd-view=\"list\" role=\"switch\" type=\"checkbox\" :checked=true]",
  "            span.swd-settings-knob",
  "        label.swd-settings-row",
  "          span.swd-settings-label",
  "            span.swd-settings-name \"Board\"",
  "            span.swd-settings-hint \"The view board: offered in the switcher above every database\"",
  "          span.swd-settings-switch",
  "            input [data-swd-view=\"board\" role=\"switch\" type=\"checkbox\" :checked=true]",
  "            span.swd-settings-knob",
  "        label.swd-settings-row",
  "          span.swd-settings-label",
  "            span.swd-settings-name \"Calendar\"",
  "            span.swd-settings-hint \"The view calendar: offered in the switcher above every database\"",
  "          span.swd-settings-switch",
  "            input [data-swd-view=\"calendar\" role=\"switch\" type=\"checkbox\" :checked=true]",
  "            span.swd-settings-knob",
  "        div.swd-settings-module-settings",
  "          label.swd-settings-row",
  "            span.swd-settings-label",
  "              span.swd-settings-name \"Week starts on\"",
  "              span.swd-settings-hint \"The first day of a calendar's weeks\"",
  "            select [data-swd-setting=\"silverware.database.views.calendar.weekStart\" :value=\"Monday\"]",
  "              option \"Monday\"",
  "              option \"Sunday\"",
  "        label.swd-settings-row",
  "          span.swd-settings-label",
  "            span.swd-settings-name \"Timeline\"",
  "            span.swd-settings-hint \"The view timeline: offered in the switcher above every database\"",
  "          span.swd-settings-switch",
  "            input [data-swd-view=\"timeline\" role=\"switch\" type=\"checkbox\" :checked=true]",
  "            span.swd-settings-knob",
  "        label.swd-settings-row",
  "          span.swd-settings-label",
  "            span.swd-settings-name \"Names\"",
  "            span.swd-settings-hint \"The view names: offered in the switcher above every database\"",
  "          span.swd-settings-switch",
  "            input [data-swd-view=\"names\" role=\"switch\" type=\"checkbox\" :checked=true]",
  "            span.swd-settings-knob",
  "        label.swd-settings-row",
  "          span.swd-settings-label",
  "            span.swd-settings-name \"Count\"",
  "            span.swd-settings-hint \"The view count: offered in the switcher above every database\"",
  "          span.swd-settings-switch",
  "            input [data-swd-view=\"count\" role=\"switch\" type=\"checkbox\" :checked=true]",
  "            span.swd-settings-knob",
  "    div.swd-settings-panel [data-swd-panel=\"modules\" hidden=\"\" role=\"tabpanel\"]",
  "      div.swd-settings-card",
  "        label.swd-settings-row",
  "          span.swd-settings-label",
  "            span.swd-settings-name \"Properties\"",
  "            span.swd-settings-hint \"A Properties button beside every database: add properties, change their label, key, type, a select's options, read only and order, remove them. A change of the items' values is shown first.\"",
  "          span.swd-settings-switch",
  "            input [data-swd-module=\"properties\" role=\"switch\" type=\"checkbox\" :checked=true]",
  "            span.swd-settings-knob",
  "        label.swd-settings-row",
  "          span.swd-settings-label",
  "            span.swd-settings-name \"Peek\"",
  "            span.swd-settings-hint \"An item opened from a view shows in a panel beside the editor: its name, its properties and its content edited there, the item itself one press away (Open). Off: an item opens where it is kept.\"",
  "          span.swd-settings-switch",
  "            input [data-swd-module=\"peek\" role=\"switch\" type=\"checkbox\" :checked=true]",
  "            span.swd-settings-knob",
  "        div.swd-settings-module-settings",
  "          label.swd-settings-row",
  "            span.swd-settings-label",
  "              span.swd-settings-name \"Width\"",
  "              span.swd-settings-hint \"The panel's width in pixels, for every database (its left edge dragged sets it too; at most most of the editor's area)\"",
  "            input [data-swd-setting=\"silverware.database.modules.peek.width\" title=\"\" type=\"number\" :value=\"600\"]",
  "        label.swd-settings-row",
  "          span.swd-settings-label",
  "            span.swd-settings-name \"Full screen\"",
  "            span.swd-settings-hint \"An icon among a database's tools shows it over the whole window, its views and tools as they are; the same icon or Esc puts it back in its page.\"",
  "          span.swd-settings-switch",
  "            input [data-swd-module=\"fullscreen\" role=\"switch\" type=\"checkbox\" :checked=true]",
  "            span.swd-settings-knob",
  "  div.swd-settings-foot",
  "    div.swd-settings-note",
  "    button.swd-settings-cancel [type=\"button\"] \"Cancel\"",
  "    button.swd-settings-save [disabled=\"\" type=\"button\"] \"Save\""
]
