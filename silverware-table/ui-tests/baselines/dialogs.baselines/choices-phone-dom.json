[
  "div.swt-choices-dialog.swt-dialog [aria-label=\"Choices\" aria-modal=\"true\" role=\"dialog\" tabindex=\"-1\"]",
  "  div.swt-dialog-head",
  "    div.swt-dialog-titles",
  "      h2.swt-dialog-title \"Choices\"",
  "      p.swt-dialog-subtitle \"Status\"",
  "    button.swt-dialog-close [aria-label=\"Close (Esc)\" title=\"Close (Esc)\" type=\"button\"]",
  "      svg [aria-hidden=\"true\" svg=94a72995]",
  "  div.swt-dialog-body",
  "    div.swt-choices-form",
  "      div.swt-choices-ways [aria-label=\"Values\" role=\"radiogroup\"]",
  "        label.swt-choices-way [title=\"The editor offers the values the column has; nothing is checked. #choice\"]",
  "          input [type=\"radio\" :checked=false]",
  "          span \"Column's values\"",
  "        label.swt-choices-way [title=\"Kept in this table: values not in it are marked, the column sorts in its order. A value renamed is renamed in the cells; one removed leaves its cells marked.\"]",
  "          input [type=\"radio\" :checked=true]",
  "          span \"Own list\"",
  "        label.swt-choices-way [title=\"A formula's values (a list, or one column; a source of the space: =@projects): values not in them are marked, the column sorts in their order.\"]",
  "          input [type=\"radio\" :checked=false]",
  "          span \"Formula\"",
  "      p.swt-choices-hint \"Kept in this table: values not in it are marked, the column sorts in its order. A value renamed is renamed in the cells; one removed leaves its cells marked.\"",
  "      p.swt-choices-hint [hidden=\"\"]",
  "      label.swt-choices-label.swt-choices-name-row",
  "        span \"Name\"",
  "        input.swt-choices-name [aria-label=\"Name of the list\" :value=\"status\"]",
  "        span.swt-choices-tag \"#choice-status\"",
  "      div.swt-choices-list",
  "        div.swt-choices-label \"Values\"",
  "        div.swt-choices-values",
  "          div.swt-choices-row",
  "            button.swt-choices-grip.swt-choices-icon [title=\"Move (drag, or Alt+↑ ↓)\" type=\"button\"]",
  "              svg [aria-hidden=\"true\" svg=ea7731d4]",
  "            input.swt-choices-value [aria-label=\"Value\" :value=\"open\"]",
  "            button.swt-choices-icon [title=\"Remove (its cells stay, marked as not of the list)\" type=\"button\"]",
  "              svg [aria-hidden=\"true\" svg=94a72995]",
  "          div.swt-choices-row",
  "            button.swt-choices-grip.swt-choices-icon [title=\"Move (drag, or Alt+↑ ↓)\" type=\"button\"]",
  "              svg [aria-hidden=\"true\" svg=ea7731d4]",
  "            input.swt-choices-value [aria-label=\"Value\" :value=\"in progress\"]",
  "            button.swt-choices-icon [title=\"Remove (its cells stay, marked as not of the list)\" type=\"button\"]",
  "              svg [aria-hidden=\"true\" svg=94a72995]",
  "          div.swt-choices-row",
  "            button.swt-choices-grip.swt-choices-icon [title=\"Move (drag, or Alt+↑ ↓)\" type=\"button\"]",
  "              svg [aria-hidden=\"true\" svg=ea7731d4]",
  "            input.swt-choices-value [aria-label=\"Value\" :value=\"done\"]",
  "            button.swt-choices-icon [title=\"Remove (its cells stay, marked as not of the list)\" type=\"button\"]",
  "              svg [aria-hidden=\"true\" svg=94a72995]",
  "        div.swt-choices-actions",
  "          button.swt-dialog-button [type=\"button\"] \"Add value\"",
  "          button.swt-dialog-button [title=\"Add the values the column has that the list has not\" type=\"button\"] \"Take values from the column\"",
  "      div.swt-choices-formula.swt-choices-part [hidden=\"\"]",
  "        div.swt-choices-label \"Formula\"",
  "        span.swt-formulafield",
  "          span.swt-formulafield-input",
  "            input.swt-formulafield-text [aria-label=\"Formula\" data-focus=\"formula\" placeholder=\"=@projects\" type=\"text\" :value=\"\"]",
  "            div.swt-formulafield-choices [hidden=\"\" role=\"listbox\"]",
  "          span.swt-formulafield-problem",
  "          div.swt-formulafield-help",
  "      div.swt-choices-part.swt-choices-preview [hidden=\"\"]",
  "        div.swt-choices-label \"Values\"",
  "          span.swt-choices-count",
  "        div.swt-choices-preview-values",
  "  div.swt-dialog-foot",
  "    div.swt-choices-foot",
  "      span.swt-dialog-note",
  "      button.swt-dialog-button [type=\"button\"] \"Cancel\"",
  "      button.swt-dialog-primary [type=\"button\"] \"Save\""
]
