[
  "div.swt-dialog.swt-pivot-dialog [aria-label=\"Pivot table\" aria-modal=\"true\" role=\"dialog\" tabindex=\"-1\"]",
  "  div.swt-dialog-head",
  "    div.swt-dialog-titles",
  "      h2.swt-dialog-title \"Pivot table\"",
  "      p.swt-dialog-subtitle \"A summary of a table, written into the page and calculated anew as the table changes\"",
  "    button.swt-dialog-close [aria-label=\"Close (Esc)\" title=\"Close (Esc)\" type=\"button\"]",
  "      svg [aria-hidden=\"true\" svg=94a72995]",
  "  div.swt-dialog-body",
  "    div.swt-pivot",
  "      div.swt-pivot-form",
  "        div.swt-pivot-section",
  "          div.swt-pivot-label",
  "            span.swt-pivot-name \"Source\"",
  "            span.swt-pivot-hint \"The table summarized\"",
  "          div.swt-pivot-fields",
  "            select [aria-label=\"Source\" data-focus=\"Source\" :value=\"fruit\"]",
  "              optgroup",
  "                option \"fruit\"",
  "                option \"towns\"",
  "              option \"Another page…\"",
  "        div.swt-pivot-section",
  "          div.swt-pivot-label",
  "            span.swt-pivot-name \"Rows\"",
  "            span.swt-pivot-hint \"A row for each value of\"",
  "          div.swt-pivot-fields",
  "            div.swt-pivot-row",
  "              select [aria-label=\"Row 1 column\" data-focus=\"Row 1 column\" :value=\"Name\"]",
  "                option \"Name\"",
  "                option \"Qty\"",
  "              select [aria-label=\"Row 1 grouping\" data-focus=\"Row 1 grouping\" :value=\"\"]",
  "                option \"as it is\"",
  "                option \"by year\"",
  "                option \"by quarter\"",
  "                option \"by month\"",
  "                option \"by month of the year\"",
  "                option \"by day\"",
  "              button.swt-pivot-formula [title=\"Write it as a formula\" type=\"button\"] \"fx\"",
  "              button.swt-pivot-remove [aria-label=\"Remove\" title=\"Remove\" type=\"button\"] \"×\"",
  "            button.swt-pivot-add [type=\"button\"] \"+ Group rows\"",
  "        div.swt-pivot-section",
  "          div.swt-pivot-label",
  "            span.swt-pivot-name \"Columns\"",
  "            span.swt-pivot-hint \"A column for each value of (optional)\"",
  "          div.swt-pivot-fields",
  "            button.swt-pivot-add [type=\"button\"] \"+ Group columns\"",
  "        div.swt-pivot-section",
  "          div.swt-pivot-label",
  "            span.swt-pivot-name \"Values\"",
  "            span.swt-pivot-hint \"What each shows\"",
  "          div.swt-pivot-fields",
  "            div.swt-pivot-row",
  "              select [aria-label=\"Value 1 function\" data-focus=\"Value 1 function\" :value=\"SUM\"]",
  "                option \"Sum\"",
  "                option \"Average\"",
  "                option \"Count\"",
  "                option \"Min\"",
  "                option \"Max\"",
  "              span.swt-pivot-of \"of\"",
  "              select [aria-label=\"Value 1 column\" data-focus=\"Value 1 column\" :value=\"Qty\"]",
  "                option \"Name\"",
  "                option \"Qty\"",
  "              select [aria-label=\"Value 1 shown\" data-focus=\"Value 1 shown\" :value=\"\"]",
  "                option \"as it is\"",
  "                option \"% of total\"",
  "              button.swt-pivot-formula [title=\"Write it as a formula\" type=\"button\"] \"fx\"",
  "              button.swt-pivot-remove [aria-label=\"Remove\" title=\"Remove\" type=\"button\"] \"×\"",
  "            button.swt-pivot-add [type=\"button\"] \"+ Value\"",
  "        div.swt-pivot-section",
  "          div.swt-pivot-label",
  "            span.swt-pivot-name \"Only rows where\"",
  "            span.swt-pivot-hint \"Its conditions\"",
  "          div.swt-pivot-fields",
  "            button.swt-pivot-add [type=\"button\"] \"+ Condition\"",
  "        div.swt-pivot-section",
  "          div.swt-pivot-label",
  "            span.swt-pivot-name \"Order\"",
  "            span.swt-pivot-hint \"The rows sorted by\"",
  "          div.swt-pivot-fields",
  "            div.swt-pivot-row",
  "              select [aria-label=\"Sort by\" data-focus=\"Sort by\" :value=\"\"]",
  "                option \"their groups\"",
  "                option \"Name\"",
  "                option \"SUM([Qty])\"",
  "        div.swt-pivot-section",
  "          div.swt-pivot-label",
  "            span.swt-pivot-name \"Totals\"",
  "            span.swt-pivot-hint",
  "          div.swt-pivot-fields",
  "            div.swt-pivot-row",
  "              label.swt-pivot-toggle \"Total row\"",
  "                input [data-focus=\"Total row\" type=\"checkbox\" :checked=true]",
  "      div.swt-pivot-label.swt-pivot-preview-title \"Preview\"",
  "      div.swt-pivot-preview",
  "        div.swt-pivot-scroll",
  "          table.swt-pivot-table",
  "            thead",
  "              tr",
  "                th \"Name\"",
  "                th \"Sum of Qty\"",
  "            tbody",
  "              tr",
  "                td \"Fig\"",
  "                td.swt-pivot-number \"5\"",
  "              tr",
  "                td \"Pear\"",
  "                td.swt-pivot-number \"3\"",
  "              tr",
  "                td \"Total\"",
  "                td.swt-pivot-number \"8\"",
  "        p.swt-pivot-size \"3 rows × 2 columns\"",
  "  div.swt-dialog-foot",
  "    div.swt-pivot-foot",
  "      span.swt-pivot-note",
  "      button.swt-dialog-button [type=\"button\"] \"Cancel\"",
  "      button.swt-dialog-primary [title=\"\" type=\"button\"] \"Insert\""
]
