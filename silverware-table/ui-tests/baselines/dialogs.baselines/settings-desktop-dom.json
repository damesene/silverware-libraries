  "            span.swt-settings-switch",
  "              input [data-swt-module=\"formulas\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
  "        div.swt-settings-module",
  "          label.swt-settings-row",
  "            span.swt-settings-label",
  "              span.swt-settings-name \"Names\"",
  "              span.swt-settings-hint \"Name tables, columns, rows and cells, to refer to them in formulas\"",
  "            span.swt-settings-switch",
  "              input [data-swt-module=\"names\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
