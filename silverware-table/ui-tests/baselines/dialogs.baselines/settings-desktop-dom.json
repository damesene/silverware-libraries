  "            span.swt-settings-switch",
  "              input [data-swt-module=\"view\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
  "    div.swt-settings-panel [data-swt-panel=\"look\" hidden=\"\" role=\"tabpanel\"]",
  "      div.swt-settings-card",
