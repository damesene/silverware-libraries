[
  "div.swt-settings [aria-label=\"Silverware Table settings\" aria-modal=\"true\" role=\"dialog\" tabindex=\"-1\"]",
  "  div.swt-settings-head",
  "    div.swt-settings-titles",
  "      h2.swt-settings-title \"Silverware Table settings\"",
  "      p.swt-settings-subtitle \"For every table in the space: SilverBullet's configuration\"",
  "    button.swt-settings-close [aria-label=\"Close (Esc)\" title=\"Close (Esc)\" type=\"button\"]",
  "      svg [aria-hidden=\"true\" svg=94a72995]",
  "  div.swt-settings-tabs [role=\"tablist\"]",
  "    button.swt-settings-tab [aria-selected=\"true\" data-swt-tab=\"general\" role=\"tab\" type=\"button\"] \"General\"",
  "    button.swt-settings-tab [aria-selected=\"false\" data-swt-tab=\"editing\" role=\"tab\" type=\"button\"] \"Editing\"",
  "    button.swt-settings-tab [aria-selected=\"false\" data-swt-tab=\"data\" role=\"tab\" type=\"button\"] \"Data\"",
  "    button.swt-settings-tab [aria-selected=\"false\" data-swt-tab=\"look\" role=\"tab\" type=\"button\"] \"Look\"",
  "    button.swt-settings-tab [aria-selected=\"false\" data-swt-tab=\"view\" role=\"tab\" type=\"button\"] \"View\"",
  "    button.swt-settings-tab [aria-selected=\"false\" data-swt-tab=\"export\" role=\"tab\" type=\"button\"] \"Export\"",
  "  div.swt-settings-body",
  "    div.swt-settings-panel [data-swt-panel=\"general\" role=\"tabpanel\"]",
  "      h3.swt-settings-group \"Tables\"",
  "      div.swt-settings-card",
  "        label.swt-settings-row [data-swt-setting=\"silverware.table.metadata\"]",
  "          span.swt-settings-label",
  "            span.swt-settings-name \"Store table metadata\"",
  "            span.swt-settings-hint \"Tables keep their sorting, filters, column widths, pins, names and formulas in a hidden last row; pinning and new formulas need it. Off, nothing new is stored (sorting and filters are only a view); what a table has may change or go\"",
  "          span.swt-settings-switch",
  "            input [role=\"switch\" type=\"checkbox\"]",
  "            span.swt-settings-knob",
  "        label.swt-settings-row [data-swt-setting=\"silverware.table.maxHeight\"]",
  "          span.swt-settings-label",
  "            span.swt-settings-name \"Maximum table height (px)\"",
  "            span.swt-settings-hint \"A taller table gets its own scrollbar; 0: no limit\"",
  "          input [type=\"number\"]",
  "        label.swt-settings-row [data-swt-setting=\"silverware.table.toolbarNames\"]",
  "          span.swt-settings-label",
  "            span.swt-settings-name \"Names in the toolbar\"",
  "            span.swt-settings-hint \"A table's toolbar shows the sheet it is on and its name, as its ⋯ menu does: always, or while you hold Shift; never, they are in the menu only\"",
  "          select",
  "            option \"Never\"",
  "            option \"Always\"",
  "            option \"While Shift is held\"",
  "      h3.swt-settings-group \"Formatting\"",
  "      div.swt-settings-card",
  "        label.swt-settings-row [data-swt-setting=\"silverware.table.autoFormat\"]",
  "          span.swt-settings-label",
  "            span.swt-settings-name \"Auto-format on edit\"",
  "            span.swt-settings-hint \"A table edited with Silverware Table is written with its columns aligned, as Long cells says; off, each table keeps its own style\"",
  "          span.swt-settings-switch",
  "            input [role=\"switch\" type=\"checkbox\"]",
  "            span.swt-settings-knob",
  "        div.swt-settings-module",
  "          label.swt-settings-row [data-swt-setting=\"silverware.table.formatLong\"]",
  "            span.swt-settings-label",
  "              span.swt-settings-name \"Long cells\"",
  "              span.swt-settings-hint \"For auto-format and Format table: pad columns up to a width (longer cells stick out), or write the whole table compact when a line is too long\"",
  "            select",
  "              option \"Limit column width\"",
  "              option \"Compact if too wide\"",
  "          div.swt-settings-module-settings",
  "            label.swt-settings-row [data-swt-setting=\"silverware.table.formatCellWidth\"]",
  "              span.swt-settings-label",
  "                span.swt-settings-name \"Max padded cell (chars)\"",
  "                span.swt-settings-hint \"Each column is padded to its longest cell of at most this many characters. A longer cell, such as a long link, is written as it is, past the column's |, so the other rows and the delimiter do not widen. 0: no limit\"",
  "              input [type=\"number\"]",
  "          div.swt-settings-module-settings [hidden=\"\"]",
  "            label.swt-settings-row [data-swt-setting=\"silverware.table.formatLineWidth\"]",
  "              span.swt-settings-label",
  "                span.swt-settings-name \"Max line length (chars)\"",
  "                span.swt-settings-hint \"A table whose longest line would be longer than this, its columns padded, is written compact: no padding, the delimiter row --- (as Prettier does with proseWrap never). 0: no limit\"",
  "              input [type=\"number\"]",
  "      h3.swt-settings-group \"Cell editor\"",
  "      div.swt-settings-card",
  "        label.swt-settings-row [data-swt-setting=\"silverware.table.editor.enterKey\"]",
  "          span.swt-settings-label",
  "            span.swt-settings-name \"Enter in a cell editor\"",
  "            span.swt-settings-hint \"What Enter does while a cell is edited\"",
  "          select",
  "            option \"Save\"",
  "            option \"Save, edit the cell below (on the last row, a new one)\"",
  "            option \"Save, edit the cell below (on the last row, only save)\"",
  "        label.swt-settings-row [data-swt-setting=\"silverware.table.editor.selectOnClick\"]",
  "          span.swt-settings-label",
  "            span.swt-settings-name \"Click selects the cell's text\"",
  "            span.swt-settings-hint \"A cell opened for editing (a click, Enter, Tab, Ctrl+arrows) has its whole text selected; off, the cursor is at its end\"",
  "          span.swt-settings-switch",
  "            input [role=\"switch\" type=\"checkbox\"]",
  "            span.swt-settings-knob",
  "        label.swt-settings-row [data-swt-setting=\"silverware.table.editor.ctrlEnterAddsRow\"]",
  "          span.swt-settings-label",
  "            span.swt-settings-name \"Ctrl+Enter adds a row\"",
  "            span.swt-settings-hint \"While a cell is edited, Ctrl+Enter saves it, adds an empty row below and edits it; off, it works like Enter\"",
  "          span.swt-settings-switch",
  "            input [role=\"switch\" type=\"checkbox\"]",
  "            span.swt-settings-knob",
  "      h3.swt-settings-group \"Cells with Lua expressions\"",
  "      div.swt-settings-card",
  "        label.swt-settings-row [data-swt-setting=\"silverware.table.expressions.refreshDelay\"]",
  "          span.swt-settings-label",
  "            span.swt-settings-name \"Delay before refreshing (ms)\"",
  "            span.swt-settings-hint \"After an edit, cells with ${…} (a query, a sum) are evaluated again once SilverBullet has indexed the page: how long to wait for that; raise it if they still show old values\"",
  "          input [type=\"number\"]",
  "    div.swt-settings-panel [data-swt-panel=\"editing\" hidden=\"\" role=\"tabpanel\"]",
  "      div.swt-settings-card",
  "        div.swt-settings-module",
  "          label.swt-settings-row",
  "            span.swt-settings-label",
  "              span.swt-settings-name \"Cell selection\"",
  "              span.swt-settings-hint \"A click selects a cell, as in a spreadsheet; drag or Shift to select more, to copy, paste over or empty them\"",
  "            span.swt-settings-switch",
  "              input [data-swt-module=\"selection\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
  "        div.swt-settings-module",
  "          label.swt-settings-row",
  "            span.swt-settings-label",
  "              span.swt-settings-name \"AutoFill\"",
  "              span.swt-settings-hint \"A square at the corner of the cells selected: drag it to fill the cells after them (1, 2 → 3, 4; Mon → Tue; formulas with their references moved), double-click it to fill down\"",
  "            span.swt-settings-switch",
  "              input [data-swt-module=\"autofill\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
  "        div.swt-settings-module",
  "          label.swt-settings-row",
  "            span.swt-settings-label",
  "              span.swt-settings-name \"Lazy saving\"",
  "              span.swt-settings-hint \"An icon in a table's toolbar switches it to saving its cells edited together, a moment after editing stops: quicker typing in large tables\"",
  "            span.swt-settings-switch",
  "              input [data-swt-module=\"lazy\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
  "          div.swt-settings-module-settings",
  "            label.swt-settings-row [data-swt-setting=\"silverware.table.modules.lazy.delay\"]",
  "              span.swt-settings-label",
  "                span.swt-settings-name \"Saves after (ms)\"",
  "                span.swt-settings-hint \"In lazy saving, the cells edited are saved this long after no cell is being edited\"",
  "              input [type=\"number\"]",
  "        div.swt-settings-module",
  "          label.swt-settings-row",
  "            span.swt-settings-label",
  "              span.swt-settings-name \"Copy, cut and paste\"",
  "              span.swt-settings-hint \"Copy, Cut and Paste in the cell menu; Ctrl+X cuts cells (they move where they are pasted); Ctrl+V pastes cells copied from a spreadsheet over the table, Ctrl+Shift+V as new rows\"",
  "            span.swt-settings-switch",
  "              input [data-swt-module=\"paste\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
  "        div.swt-settings-module",
  "          label.swt-settings-row",
  "            span.swt-settings-label",
  "              span.swt-settings-name \"Row and column handles\"",
  "              span.swt-settings-hint \"Handles beside rows and above columns: drag to move them, click for their menu\"",
  "            span.swt-settings-switch",
  "              input [data-swt-module=\"handles\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
  "    div.swt-settings-panel [data-swt-panel=\"data\" hidden=\"\" role=\"tabpanel\"]",
  "      div.swt-settings-card",
