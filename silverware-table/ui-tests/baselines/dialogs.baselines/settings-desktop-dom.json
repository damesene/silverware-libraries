  "            span.swt-settings-switch",
  "              input [data-swt-module=\"sources\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
  "        div.swt-settings-module",
  "          label.swt-settings-row",
  "            span.swt-settings-label",
  "              span.swt-settings-name \"Filters\"",
  "              span.swt-settings-hint \"Show only the rows whose cells match what you type under a header\"",
  "            span.swt-settings-switch",
  "              input [data-swt-module=\"filters\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
  "          div.swt-settings-module-settings",
  "            label.swt-settings-row [data-swt-setting=\"silverware.table.modules.filters.smart\"]",
  "              span.swt-settings-label",
  "                span.swt-settings-name \"Smart filters\"",
  "                span.swt-settings-hint \"Filters understand >10, /pattern/, =text, a|b and !text; off, what is typed is text to find\"",
  "              span.swt-settings-switch",
  "                input [role=\"switch\" type=\"checkbox\"]",
  "                span.swt-settings-knob",
  "        div.swt-settings-module",
  "          label.swt-settings-row",
  "            span.swt-settings-label",
  "              span.swt-settings-name \"Column types\"",
  "              span.swt-settings-hint \"A header's hashtag formats its column (#currency, #stars…)\"",
  "            span.swt-settings-switch",
  "              input [data-swt-module=\"columnTypes\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
  "        div.swt-settings-module",
  "          label.swt-settings-row",
  "            span.swt-settings-label",
  "              span.swt-settings-name \"Pivot tables\"",
  "              span.swt-settings-hint \"Tables that summarize another (pivot.source in their metadata row), calculated anew with each of its edits\"",
  "            span.swt-settings-switch",
  "              input [data-swt-module=\"pivot\" role=\"switch\" type=\"checkbox\"]",
  "              span.swt-settings-knob",
  "        div.swt-settings-module",
  "          label.swt-settings-row",
  "            span.swt-settings-label",
  "              span.swt-settings-name \"Views\"",
