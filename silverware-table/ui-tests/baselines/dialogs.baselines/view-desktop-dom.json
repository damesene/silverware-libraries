[
  "div.swt-dialog.swt-view-dialog [aria-label=\"View\" aria-modal=\"true\" role=\"dialog\" tabindex=\"-1\"]",
  "  div.swt-dialog-head",
  "    div.swt-dialog-titles",
  "      h2.swt-dialog-title \"View\"",
  "      p.swt-dialog-subtitle \"A table made by a formula, written into the page and calculated anew as what it reads changes\"",
  "    button.swt-dialog-close [aria-label=\"Close (Esc)\" title=\"Close (Esc)\" type=\"button\"]",
  "      svg [aria-hidden=\"true\" svg=94a72995]",
  "  div.swt-dialog-body",
  "    div.swt-view",
  "      div.swt-view-form",
  "        div.swt-view-section",
  "          div.swt-view-label",
  "            span.swt-view-name \"Formula\"",
  "            span.swt-view-hint \"What the table shows: its result, a value, a list or rows and columns\"",
  "          div.swt-view-fields",
  "            div.swt-view-row",
  "              span.swt-formulafield",
  "                span.swt-formulafield-input",
  "                  input.swt-formulafield-text [aria-label=\"Formula\" data-focus=\"formula\" placeholder=\"=SORT(FILTER(tasks![#Data], tasks![done] = FALSE))\" type=\"text\" :value=\"=fruit![#Data]\"]",
  "                  div.swt-formulafield-choices [hidden=\"\" role=\"listbox\"]",
  "                span.swt-formulafield-problem",
  "                div.swt-formulafield-help",
  "              button.swt-view-fx [aria-label=\"Functions\" title=\"Functions: find one by its name or what it does, and put it in at the caret\" type=\"button\"] \"fx\"",
  "        div.swt-view-section",
  "          div.swt-view-label",
  "            span.swt-view-name \"Name\"",
  "            span.swt-view-hint \"Other formulas read the view by it\"",
  "          div.swt-view-fields",
  "            div.swt-view-row",
  "              input [aria-label=\"Name\" data-focus=\"name\" placeholder=\"none: no formula reads it\" type=\"text\" :value=\"view1\"]",
  "              span.swt-view-problem",
  "      div.swt-view-label.swt-view-preview-title \"Preview\"",
  "      div.swt-view-preview",
  "        div.swt-view-scroll",
  "          table.swt-view-table",
  "            thead",
  "              tr",
  "                th \"Name\"",
  "                th \"Qty\"",
  "            tbody",
  "              tr",
  "                td \"Pear\"",
  "                td.swt-view-number \"3\"",
  "              tr",
  "                td \"Fig\"",
  "                td.swt-view-number \"5\"",
  "        p.swt-view-size \"2 rows × 2 columns\"",
  "  div.swt-dialog-foot",
  "    div.swt-view-foot",
  "      span.swt-view-note",
  "      button.swt-dialog-button [type=\"button\"] \"Cancel\"",
  "      button.swt-dialog-primary [title=\"\" type=\"button\"] \"Insert\""
]
